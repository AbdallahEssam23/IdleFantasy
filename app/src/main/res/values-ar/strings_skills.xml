<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Skill names and descriptions ===== -->

    <!-- Gathering skills -->
    <string name="skill_mining_name">التعدين</string>
    <string name="skill_mining_desc">استخرج الخامات والأحجار الكريمة القيّمة من باطن الأرض.</string>
    <string name="skill_fishing_name">الصيد</string>
    <string name="skill_fishing_desc">اصطد الأسماك والكنوز المائية من أعماق المياه.</string>
    <string name="skill_woodcutting_name">قطع الأخشاب</string>
    <string name="skill_woodcutting_desc">اقطع الأشجار واجمع أنواعًا مختلفة من الأخشاب.</string>
    <string name="skill_farming_name">الزراعة</string>
    <string name="skill_farming_desc">ازرع المحاصيل واحصدها من رقعك الزراعية.</string>
    <string name="skill_firemaking_name">إشعال النار</string>
    <string name="skill_firemaking_desc">أحرق الجذوع من مخزونك لاكتساب نقاط خبرة إشعال النار. ينتج عن حرق كل جذع رماد أيضًا، ويمكن نثره في مهارة الصلاة لاكتساب نقاط خبرة صلاة إضافية.</string>
    <string name="skill_agility_name">الرشاقة</string>
    <string name="skill_agility_desc">درّب مهارة الرشاقة لتقليل مدة جلسات جميع المهارات. يقلّل المستوى 99 مدة الجلسة %1$d دقيقة في الساعة (من 60 دقيقة إلى %2$d دقيقة)، مع انخفاض تدريجي منتظم كلما ارتفع مستواك.</string>

    <!-- Crafting skills -->
    <string name="skill_smithing_name">الحدادة</string>
    <string name="skill_smithing_desc">صَهِر الخامات إلى سبائك واصنع معدات معدنية قوية.</string>
    <string name="skill_cooking_name">الطبخ</string>
    <string name="skill_cooking_desc">اطبخ المكونات النيئة لتحضير طعام يستعيد نقاط الصحة في القتال.</string>
    <string name="skill_fletching_name">صناعة السهام</string>
    <string name="skill_fletching_desc">اصنع الأقواس والسهام من الجذوع والمكوّنات المعدنية.</string>
    <string name="skill_crafting_name">الصناعة</string>
    <string name="skill_crafting_desc">اصنع الحلي وغيرها من المنتجات من مواد نفيسة.</string>
    <string name="skill_runecrafting_name">صناعة الرونات</string>
    <string name="skill_runecrafting_desc">اصنع رونات سحرية من جوهر الرون لاستخدامها في إلقاء التعويذات.</string>
    <string name="skill_herblore_name">علم الأعشاب</string>
    <string name="skill_herblore_desc">حضّر الجرعات من أعشاب الزراعة ومكوّنات الدهاليز لتعزيز إحصاءات القتال لديك.</string>

    <!-- Combat skills -->
    <string name="skill_attack_name">الهجوم</string>
    <string name="skill_attack_desc">حسّن دقتك في القتال القريب، فترتفع فرصتك في إصابة الهدف.</string>
    <string name="skill_strength_name">القوة</string>
    <string name="skill_strength_desc">زد أقصى ضرر تلحقه في كل ضربة قريبة.</string>
    <string name="skill_defense_name">الدفاع</string>
    <string name="skill_defense_desc">قلّل الضرر الذي تتلقاه من هجمات الأعداء.</string>
    <string name="skill_ranged_name">القتال بعيد المدى</string>
    <string name="skill_ranged_desc">هاجم الأعداء من مسافة آمنة باستخدام القوس والسهام.</string>
    <string name="skill_magic_name">السحر</string>
    <string name="skill_magic_desc">ألقِ تعويذات قوية باستخدام الرونات. تتيح المستويات الأعلى تعويذات أشد قوة.</string>
    <string name="skill_hitpoints_name">نقاط الصحة</string>
    <string name="skill_hitpoints_desc">تمثّل صحتك الإجمالية. تتيح لك المستويات الأعلى الصمود مدة أطول في القتال.</string>
    <string name="skill_prayer_name">الصلاة</string>
    <string name="skill_prayer_desc">ادفن العظام التي يسقطها الأعداء في القتال لاكتساب نقاط خبرة الصلاة. تتيح المستويات الأعلى بركات أقوى من الكنيسة.</string>

