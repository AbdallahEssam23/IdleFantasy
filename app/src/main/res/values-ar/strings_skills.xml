    <!-- ===== Agility course names and descriptions ===== -->
    <string name="agility_beginner_course_name">مسار المبتدئين</string>
    <string name="agility_beginner_course_desc">مسار حواجز بسيط لمن بدأوا للتو تدريب الرشاقة.</string>
    <string name="agility_novice_course_name">مسار الناشئين</string>
    <string name="agility_novice_course_desc">مسار أكثر تحديًا قليلًا، يضم حواجز أساسية.</string>
    <string name="agility_apprentice_course_name">مسار المتدرّبين</string>
    <string name="agility_apprentice_course_desc">مسار متوسط يتطلب بعض المهارة لاجتيازه.</string>
    <string name="agility_intermediate_course_name">المسار المتوسط</string>
    <string name="agility_intermediate_course_desc">مسار متوسط الصعوبة يضم حواجز صعبة التجاوز.</string>
    <string name="agility_advanced_course_name">المسار المتقدم</string>
    <string name="agility_advanced_course_desc">مسار مليء بالتحديات يختبر براعتك في الرشاقة.</string>
    <string name="agility_expert_course_name">مسار الخبراء</string>
    <string name="agility_expert_course_desc">مسار بمستوى الخبراء، يضم حواجز خطرة.</string>
    <string name="agility_elite_course_name">مسار النخبة</string>
    <string name="agility_elite_course_desc">لا يتقن هذا المسار النخبوي إلا الأشد رشاقة.</string>
    <string name="agility_master_course_name">مسار الأساتذة</string>
    <string name="agility_master_course_desc">مسار بمستوى الأساتذة، يضم حواجز فائقة الصعوبة.</string>
    <string name="agility_veteran_course_name">مسار المخضرمين</string>
    <string name="agility_veteran_course_desc">ميدان تدريب المخضرمين، بتحديات قاسية.</string>
    <string name="agility_champion_course_name">مسار الأبطال</string>
    <string name="agility_champion_course_desc">مسار بمستوى الأبطال يدفعك إلى أقصى حدودك.</string>
    <string name="agility_heroic_course_name">المسار البطولي</string>
    <string name="agility_heroic_course_desc">مسار بطولي لا يجرؤ على خوضه إلا الأفضل.</string>
    <string name="agility_legendary_course_name">المسار الأسطوري</string>
    <string name="agility_legendary_course_desc">مسار أسطوري تتناقله نخبة الرشيقين همسًا.</string>
    <string name="agility_mythic_course_name">المسار الخرافي</string>
    <string name="agility_mythic_course_desc">مسار خرافي يتحدى قوانين الفيزياء.</string>
    <string name="agility_divine_course_name">المسار الإلهي</string>
    <string name="agility_divine_course_desc">مسار إلهي باركته آلهة الرشاقة.</string>
    <string name="agility_transcendent_course_name">المسار المتسامي</string>
    <string name="agility_transcendent_course_desc">الاختبار الأسمى للرشاقة، يتجاوز حدود البشر.</string>
    <!-- Elder Isle agility courses (train elder Agility to shorten isle sessions to 45 min at 99) -->
    <string name="agility_elder_coastal_run_name">العدو الساحلي</string>
    <string name="agility_elder_coastal_run_desc">هرولة على شاطئ الجزيرة الذي ندبته الأمواج. تتحرك الصخور تحت قدميك مع المد.</string>
    <string name="agility_elder_grove_traverse_name">اجتياز البستان</string>
    <string name="agility_elder_grove_traverse_desc">مسار من الحبال والحواف عبر مظلة الغابة القديمة المتلألئة بالرونات.</string>
    <string name="agility_elder_volcano_scramble_name">تسلّق البركان</string>
    <string name="agility_elder_volcano_scramble_desc">تسلّق عبر سفوح القمة المتصاعدة منها الأدخنة. ما زالت الحجارة تذكر أنها كانت مذبحًا.</string>
    <string name="agility_elder_abyssal_ascent_name">ارتقاء الهاوية</string>
    <string name="agility_elder_abyssal_ascent_desc">طريق عمودي يصعد جدران أعماق الهاوية المتشققة بفعل الضغط. قلائل يبلغون القمة.</string>

    <!-- ===== Session skill type labels ===== -->
    <string name="skill_expedition_name">الاستكشاف</string>
    <string name="skill_boss_name">الزعماء</string>
    <string name="skill_mercantile_name">التجارة</string>
    <string name="skill_mercantile_desc">أرسل قوافل التجارة عبر الطرق لكسب العملات ونقاط الخبرة. تحسّن المستويات الأعلى أسعار الشراء والبيع في المتجر وتفتح بضائع حصرية لنقابة التجار.</string>
</resources>
