    <!-- Elder Isle dungeons -->
    <string name="dungeon_beach_and_cliffs_name">الشاطئ والجروف</string>
    <string name="dungeon_beach_and_cliffs_desc">منطقة الوصول إلى الجزيرة. تنبش أعداء السواحل حطام الرحلات السابقة بحثًا عن الغنائم. لكل تطهير فرصة لإسقاط أختام عتيقة.</string>
    <string name="dungeon_ancient_forest_name">الغابة القديمة</string>
    <string name="dungeon_ancient_forest_desc">أدغال تغطي مكتبة قديمة، وتتشابك فيها الرونات. يمنع مطاردو البستان والدريادات التي مسّتها الرونات الزوار من بلوغ الأطلال في الأسفل. لكل تطهير فرصة لإسقاط أختام عتيقة.</string>
    <string name="dungeon_volcano_peak_name">قمة البركان</string>
    <string name="dungeon_volcano_peak_desc">عمود الجزيرة الفقري المتصاعد منه الدخان، وكان مذبحًا للشيوخ. تحرس وحوش الرماد وأشباح الحمم موقع الختم. لكل تطهير فرصة لإسقاط أختام عتيقة.</string>
    <string name="dungeon_abyssal_depths_name">أعماق الهاوية</string>
    <string name="dungeon_abyssal_depths_desc">حجرة ضغط غمرتها المياه عند سفح الجزيرة، حيث ينتظر الشيخ الأخير. تجوب أهوال الهاوية وسيرافيم الفراغ الطريق المؤدي إليه. يُسقط كل تطهير أختامًا عتيقة.</string>

    <!-- Elder Isle raid bosses -->
    <string name="boss_sea_serpent_name">أفعى البحر</string>
    <string name="boss_sea_serpent_desc">زعيم الرحلة. أفعى وسمتها الرونات، تطوف حول الجزيرة وتصد كل من لا تغرقه. اهزمها مرة واحدة لفتح الإبحار نهائيًا.</string>
    <string name="boss_last_elder_name">الشيخ الأخير</string>
    <string name="boss_last_elder_desc">آخر الشيوخ، مختوم في قاع أعماق الهاوية. لا يصمد في القتال إلا من يرتدي طقم الشيوخ كاملًا.</string>
</resources>
