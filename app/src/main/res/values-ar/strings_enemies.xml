    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">كهف العفاريت الصغيرة</string>
    <string name="dungeon_imp_cavern_desc">كهف ضحل يعج بالعفاريت الصغيرة المشاكسة. مثالي للمبتدئين تمامًا!</string>
    <string name="dungeon_goblin_cave_name">كهف العفاريت</string>
    <string name="dungeon_goblin_cave_desc">كهف مظلم موبوء بالعفاريت والجرذان العملاقة. مكان مناسب لتدريب المغامرين الجدد.</string>
    <string name="dungeon_spider_den_name">وكر العناكب</string>
    <string name="dungeon_spider_den_desc">كهف تعج أرجاؤه بالعناكب السامة وتغطيه الشباك. أحضر ترياقًا!</string>
    <string name="dungeon_bandit_camp_name">معسكر قطاع الطرق</string>
    <string name="dungeon_bandit_camp_desc">مخبأ للصوص والمحتالين في البرية. احذر على كيس عملاتك!</string>
    <string name="dungeon_undead_crypt_name">سرداب الموتى الأحياء</string>
    <string name="dungeon_undead_crypt_desc">مدفن عتيق يرفض فيه الموتى أن يرقدوا بسلام. احذر سحر الظلام!</string>
    <string name="dungeon_fortress_ruins_name">أطلال الحصن</string>
    <string name="dungeon_fortress_ruins_desc">بقايا قلعة عتيقة آيلة للسقوط، يحرسها الآن الفرسان والجنود.</string>
    <string name="dungeon_orc_stronghold_name">معقل الأورك</string>
    <string name="dungeon_orc_stronghold_desc">مستوطنة محصنة للأورك في أعماق الجبال. لا يجرؤ على دخولها إلا الشجعان.</string>
    <string name="dungeon_volcanic_depths_name">أعماق البركان</string>
    <string name="dungeon_volcanic_depths_desc">كهف لاهب تسكنه الكلاب الجهنمية والشياطين الدنيا. حرارته لا تُطاق!</string>
    <string name="dungeon_dragon_lair_name">عرين التنين</string>
    <string name="dungeon_dragon_lair_desc">الموطن الأسطوري للتنانين الخضراء. لا ينجو من هذا التحدي إلا المحاربون المعلّمون.</string>
    <string name="dungeon_farm_name">المزرعة</string>
    <string name="dungeon_farm_desc">مزرعة هادئة تضم مواشي. رائعة للمبتدئين الراغبين في جمع الطعام!</string>
    <string name="dungeon_infernal_stronghold_name">المعقل الجهنمي</string>
    <string name="dungeon_infernal_stronghold_desc">حصن من النار والكبريت تحكمه الشياطين والكلاب الجهنمية. قد تقتل حرارته وحدها غير المستعدين.</string>
    <string name="dungeon_ancient_temple_name">المعبد العتيق</string>
    <string name="dungeon_ancient_temple_desc">معبد عتيق تحرسه أقوى المخلوقات في العالم. لا يجرؤ على دخوله إلا أشد المحاربين بأسًا.</string>
    <string name="dungeon_void_rift_name">صدع الفراغ</string>
    <string name="dungeon_void_rift_desc">تمزق في الواقع تتدفق عبره مخلوقات الفراغ إلى عالم البشر.</string>
    <string name="dungeon_frozen_citadel_name">القلعة المتجمدة</string>
    <string name="dungeon_frozen_citadel_desc">حصن عتيق غطاه نهر جليدي، وتجمد المدافعون عنه في حراسة أبدية.</string>
    <string name="dungeon_abyssal_throne_name">عرش الهاوية</string>
    <string name="dungeon_abyssal_throne_desc">أعمق نقطة في العالم المعروف، يحكمها أسياد الفراغ منذ فجر الزمان.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">برج الشمس</string>
    <string name="dungeon_sunspire_desc">أطلال برج شمسي تصدعت في الانقلاب، فأطلقت أرواح الحرارة في المنطقة. جزء من فعالية انقلاب برج الشمس.</string>
    <string name="dungeon_hollowfen_name">مستنقع الجوف</string>
    <string name="dungeon_hollowfen_desc">مستنقع غمره الضباب، تنتشر فيه المدافن الغارقة ويسير بين أرجائه موتى الحصاد. جزء من فعالية حصاد الكآبة.</string>
    <string name="dungeon_cloud_kingdom_name">مملكة السحاب</string>
    <string name="dungeon_cloud_kingdom_desc">مملكة فوق السحب، يُبلغها المرء بتسلق ساق فاصولياء أسطورية. تجوب العمالقة جزرها العائمة الشاسعة، وتنزلق أفاعي السماء بين كتل السحاب، بينما تتقد عفاريت العواصف بطاقة لا تهدأ. قلائل رأوها، وأقل منهم عادوا ليروا ما شاهدوه.</string>
    <string name="dungeon_blightwood_name">غابة الذبول</string>
    <string name="dungeon_blightwood_desc">غابة متعفنة وراء مستنقع الجوف، تجتمع فيها أشد أهوال حصاد الكآبة بأسًا. جزء من فعالية حصاد الكآبة.</string>

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">التنين الأسود الملك</string>
    <string name="boss_king_black_dragon_desc">تنين أسطوري ذو ثلاثة رؤوس، تهابه أرجاء العالم.</string>
    <string name="boss_demon_lord_name">سيد الشياطين</string>
    <string name="boss_demon_lord_desc">شيطان عتيق من الهاوية، وسيد السحر الأسود.</string>
    <string name="boss_kraken_name">كراكن</string>
    <string name="boss_kraken_desc">رعب أعماق البحار، وحش بحري هائل.</string>
    <string name="boss_balrog_name">جمر القوط</string>
    <string name="boss_balrog_desc">شيطان عتيق من اللهب والظلال، استيقظ من سباته في أعماق الأرض.</string>
    <string name="boss_void_sovereign_name">سيّد الفراغ</string>
    <string name="boss_void_sovereign_desc">الكيان البدئي الكامن وراء صدوع الفراغ. عتيق إلى حد لا يُتصور، وينظر باحتقار إلى متحدّيه من البشر.</string>
    <string name="boss_sol_invictus_name">سول إنفيكتوس، اللهب المنكسر</string>
    <string name="boss_sol_invictus_desc">شظية من الشمس نفسها، انتزعت من أطلال برج الشمس. لا يجرؤ على الاقتراب منها إلا أشجع المحاربين.</string>
    <string name="boss_the_hollow_king_name">الملك الأجوف</string>
    <string name="boss_the_hollow_king_desc">سيد حصاد الكآبة مقطوع الرأس، يخرج راكبًا من غابة الذبول ليحصد ما زرعه الأحياء.</string>
    <string name="boss_the_vault_guardian_name">حارس الخزنة</string>
    <string name="boss_the_vault_guardian_desc">جبار من ذهب حي، أيقظته شعلة اللهب الأبدي. لا يواجهه إلا رعاة النصب العظيم.</string>
    <string name="boss_obsidian_colossus_name">جبار السبج</string>
    <string name="boss_obsidian_colossus_desc">جبل استحال غضبًا. لم ينجح بطل بمفرده قط في إحداث أكثر من ندبة فيه. أحضر فريقًا.</string>
    <string name="boss_brood_empress_name">إمبراطورة السرب</string>
    <string name="boss_brood_empress_desc">أم السرب الذي يجوب الفضاء بين النجوم. قضى نسلها على جيوش، فاحرص على أن يتقاضى جيشك أجرًا سخيًا.</string>
    <string name="boss_the_world_ender_name">مدمّر العالم</string>
    <string name="boss_the_world_ender_desc">حين يتحرك، تكتب الممالك وصاياها. يلزم أربعة أسماء على العقد، وإلا فلن يعود أحد.</string>

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">المنجم المنهار</string>
    <string name="dungeon_collapsed_mine_desc">كهف شاسع تحت مناجم النحاس. تسكن الركام ترولات الكهوف وغولمات الصخور، وتنسج العناكب العملاقة شباكها عبر الأنفاق المنهارة.</string>
    <string name="dungeon_shadow_den_name">وكر الظلال</string>
    <string name="dungeon_shadow_den_desc">شبكة من الحجرات تحت الأرض تستخدمها نقابة اللصوص في المنطقة. يتربص المحتالون والقتلة ومخلوقات الظلال في كل زاوية.</string>
    <string name="dungeon_abyssal_ruins_name">أطلال الهاوية</string>
    <string name="dungeon_abyssal_ruins_desc">أطلال عتيقة توجد في آن واحد فوق عالم البشر وتحته. تتلاشى مخلوقات الهاوية الغريبة من الواقع وتعود إليه.</string>
    <string name="dungeon_ancient_forest_ruins_name">أطلال الغابة القديمة</string>
    <string name="dungeon_ancient_forest_ruins_desc">أطلال حجرية ابتلعتها الغابة البدئية، وتسكنها الآن مخلوقات متوحشة وأرواح درويد غاضبة تسعى للانتقام.</string>
    <string name="dungeon_ancient_forge_name">المسبك العتيق</string>
    <string name="dungeon_ancient_forge_desc">مسبك أقزام شاسع ظل مشتعلًا قرونًا بلا انقطاع. تحمي أسراره عناصر النار وحراس المسبك.</string>
    <string name="dungeon_arcane_ruins_name">الأطلال السحرية</string>
    <string name="dungeon_arcane_ruins_desc">الحجرات الجوفية الصالحة للاستخدام في برج ساحر مدمر. لا تزال المخلوقات السحرية والحراس المسحورون يجوبون أروقته.</string>
    <string name="dungeon_corrupted_sanctum_name">المقدس الفاسد</string>
    <string name="dungeon_corrupted_sanctum_desc">مقدس تغمره الظلال في قلب المظلة الفاسدة. يحرس كهنة الظلام والوحوش الفاسدة شرًا عتيقًا.</string>
    <string name="dungeon_drowned_temple_name">المعبد الغارق</string>
    <string name="dungeon_drowned_temple_desc">معبد غارق تحت مغارة البحر، تمتلئ أروقته بالمياه ومخلوقات البحر التي اتخذته موطنًا.</string>
    <string name="dungeon_rogue_sanctum_name">مقدس المحتالين</string>
    <string name="dungeon_rogue_sanctum_desc">ملاذ النقابة الداخلي، لا يدخله إلا أعضاؤها الذين أثبتوا جدارتهم.</string>
    <string name="dungeon_guild_of_shadows_name">نقابة الظلال</string>
    <string name="dungeon_guild_of_shadows_desc">أعمق مقدسات نقابة اللصوص، يحرسه نخبة منفذيها.</string>

